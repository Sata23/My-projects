# Copy to .env on the deployment host; never commit real values.
TELECOM_DEMO=false
PUBLIC_BASE_URL=https://telecom.example.invalid
OIDC_ISSUER=https://login.microsoftonline.com/REPLACE_TENANT_UUID/v2.0
OIDC_CLIENT_ID=REPLACE_APPLICATION_UUID
OIDC_CLIENT_SECRET=
OIDC_LOGIN_HINT=
SESSION_SECRET=
TELECOM_PII_KEY=
TELECOM_DATA_DIR=/app/runtime
EMBEDDING_BACKEND=sparse
LLM_BACKEND=extractive
# Authenticated issuer|sub -> server-approved attributes; sub is not an email address.
ACCESS_MAP_JSON={"https://login.microsoftonline.com/REPLACE_TENANT_UUID/v2.0|REPLACE_VERIFIED_SUB":{"sub":"REPLACE_VERIFIED_SUB","tenant":"telecom-demo","roles":["telecom_analyst"],"zones":["North","South","East","West","Central","Northeast"],"cities":["All"],"purposes":["analytics"]}}
